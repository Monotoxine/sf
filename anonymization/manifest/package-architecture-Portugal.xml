<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Anonymization tool, architectural work (commits 654936c, 3e893d2, d1fd9d1, 25ed70e),
     for Portugal (ALH) and any other non-standard org.

     Same dependency closure as package-architecture.xml, minus the test classes: 20 production
     classes, the whole set. See that file's header for why the closure is this wide — in short,
     buildBrandCondition arrived with 5e068c8 and an org that never received it cannot compile
     this work without TEKCO_AnonymizationOrgConfigService coming along.

     No test class here, matching what package-Portugal.xml has always done: this org never
     received them, so nothing in it references the constructors this work changed, and pushing
     brand new tests would run them at deploy time against org-specific validation rules for no
     benefit. If the org does carry the tool's test classes after all, use
     package-architecture.xml instead — a dry run tells you in one command.

     TWO THINGS TO CHECK BEFORE DEPLOYING:

     1. The custom permissions. The permission set references CXFCO_BypassCustomValidations and
        CXFCO_BypassOutboundSynchronization, which do not exist natively in this org; they are
        shipped as empty definitions and are listed below so this manifest stands alone.

     2. The org config record. CustomMetadata RECORDS are deliberately excluded here — field
        configs, patterns and org config stay as the org has them. This org DOES have a matching
        org-config record (ALH_Portugal). If its TEKCO_BypassObjectApiName__c is empty after the
        deploy, the bypass stays off silently and every anonymization update pays full
        trigger/flow/validation-rule cost. Check it, or deploy the record from
        package-Portugal.xml. Its TEKCO_OrgDomain__c must also still match the sandbox:
          System.debug(URL.getOrgDomainUrl().getHost().substringBefore('.'));

     No component is deleted, so there is no destructiveChanges file to pair with this one.

     Validate first, deploy second:
       sf project deploy start ~-manifest anonymization/manifest/package-architecture-Portugal.xml
           ~-dry-run ~-target-org <alias>
       sf project deploy start ~-manifest anonymization/manifest/package-architecture-Portugal.xml
           ~-target-org <alias>
     (replace ~- with double dashes; XML comments cannot contain them)
-->
<Package xmlns="http://soap.sforce.com/2006/04/metadata">
    <types>
        <!-- Introduced by this work -->
        <members>TEKCO_AnonymizationChainRunner</members>
        <members>TEKCO_AnonymizationPreviewService</members>
        <members>TEKCO_AnonymizationRunContext</members>
        <members>TEKCO_AnonymizationScopeQueryBuilder</members>
        <!-- Changed by this work -->
        <members>TEKCO_AnonymizationFieldBatch</members>
        <members>TEKCO_AnonymizationByIdController</members>
        <members>TEKCO_AnonymizationController</members>
        <members>TEKCO_AnonymizationExecuteService</members>
        <members>TEKCO_ContentDocumentBatch</members>
        <members>TEKCO_FieldHistoryBatch</members>
        <!-- Dependency closure: unchanged here, but the org's copies may be older than the
             API this work compiles against. -->
        <members>TEKCO_AnonymizationAuditService</members>
        <members>TEKCO_AnonymizationConfigSelector</members>
        <members>TEKCO_AnonymizationGuard</members>
        <members>TEKCO_AnonymizationBypassService</members>
        <members>TEKCO_AnonymizationOrgConfigService</members>
        <members>TEKCO_AnonymizationPatternService</members>
        <members>TEKCO_ContentDocumentDeleteService</members>
        <members>TEKCO_FieldHistoryDeleteService</members>
        <name>ApexClass</name>
    </types>
    <types>
        <!-- Before/after sample panel in both tabs. Its Apex imports are hard deploy
             dependencies on previewSample / previewSampleByIds, both shipped above. -->
        <members>tekcoDataAnonymizationAdmin</members>
        <name>LightningComponentBundle</name>
    </types>
    <types>
        <!-- The two CXFCO ones are empty definitions this org does not have natively.
             See note 1 in the header. -->
        <members>CXFCO_BypassCustomValidations</members>
        <members>CXFCO_BypassOutboundSynchronization</members>
        <members>TEKCO_AnonymizeData</members>
        <name>CustomPermission</name>
    </types>
    <types>
        <!-- Object definitions and every field they declare — records excluded on purpose,
             see note 2 in the header. -->
        <members>TEKCO_AnonymizationAuditLog__c</members>
        <members>TEKCO_AnonymizationFieldConfig__mdt</members>
        <members>TEKCO_AnonymizationOrgConfig__mdt</members>
        <members>TEKCO_AnonymizationPattern__mdt</members>
        <name>CustomObject</name>
    </types>
    <types>
        <members>TEKCO_AnonymizationAuditLog__c-TEKCO Anonymization Audit Log Layout</members>
        <name>Layout</name>
    </types>
    <types>
        <!-- Carries the field-level security for TEKCO_RunMode__c. See note 1 in the header. -->
        <members>TEKCO_AnonymizationAdmin</members>
        <name>PermissionSet</name>
    </types>
    <version>65.0</version>
</Package>
