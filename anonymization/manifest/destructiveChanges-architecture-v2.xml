<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- What the first version of the anonymization tool installed that version 2 no longer has: the
     five batch and utility classes merged into the single v2 chain, and three fields v2 dropped.
     Checked against EmeaUAT, which carries that first version. Deploy it as a POST-destructive
     change with package-architecture-v2.xml:

       sf project deploy start ~-manifest anonymization/manifest/package-architecture-v2.xml
           ~-post-destructive-changes anonymization/manifest/destructiveChanges-architecture-v2.xml
           ~-ignore-warnings ~-target-org <alias>
     (replace ~- with double dashes; XML comments cannot contain them)

     Run it with ~-ignore-warnings: a component the target org does not have is then skipped
     instead of failing the deployment.

     Run_Team_Tools is NOT listed: it is the navigation app the first version added its tab to,
     and it belongs to other teams too.
-->
<Package xmlns="http://soap.sforce.com/2006/04/metadata">
    <types>
        <members>TEKCO_AnonymizationBatch</members>
        <members>TEKCO_AnonymizationBatchUtils</members>
        <members>TEKCO_AnonymizationByIdBatch</members>
        <members>TEKCO_ContentDocumentByIdBatch</members>
        <members>TEKCO_FieldHistoryByIdBatch</members>
        <name>ApexClass</name>
    </types>
    <types>
        <members>TEKCO_AnonymizationAuditLog__c.TEKCO_FieldsAnonymized__c</members>
        <members>TEKCO_AnonymizationFieldConfig__mdt.TEKCO_ParentRecordTypeDeveloperName__c</members>
        <members>TEKCO_AnonymizationOrgConfig__mdt.TEKCO_BypassEnabled__c</members>
        <name>CustomField</name>
    </types>
    <version>65.0</version>
</Package>
