<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Removes the four batch classes superseded by the chain merge.
     Companion to package-architecture.xml and package-architecture-Portugal.xml — use as a
     POST-destructive change so the replacements deploy before these disappear:

       sf project deploy start ~-manifest anonymization/manifest/package-architecture.xml
           ~-post-destructive-changes anonymization/manifest/destructiveChanges-architecture.xml
           ~-dry-run ~-target-org <alias>
     (replace ~- with double dashes; XML comments cannot contain them)

     BEFORE DEPLOYING, CHECK THAT NO RUN IS IN FLIGHT. A chained run holds a serialized
     Database.Stateful instance; deleting the class it points at kills that run mid-chain, with
     the bypass left raised and the audit log stuck on Running:

       SELECT Id, Status, ApexClass.Name, CreatedDate FROM AsyncApexJob
       WHERE Status IN ('Queued','Processing','Preparing') AND ApexClass.Name LIKE 'TEKCO_%'

     Replacements:
       TEKCO_AnonymizationBatch, TEKCO_AnonymizationByIdBatch -> TEKCO_AnonymizationFieldBatch
       TEKCO_ContentDocumentByIdBatch                         -> TEKCO_ContentDocumentBatch
       TEKCO_FieldHistoryByIdBatch                            -> TEKCO_FieldHistoryBatch
-->
<Package xmlns="http://soap.sforce.com/2006/04/metadata">
    <types>
        <members>TEKCO_AnonymizationBatch</members>
        <members>TEKCO_AnonymizationByIdBatch</members>
        <members>TEKCO_ContentDocumentByIdBatch</members>
        <members>TEKCO_FieldHistoryByIdBatch</members>
        <name>ApexClass</name>
    </types>
    <version>65.0</version>
</Package>
