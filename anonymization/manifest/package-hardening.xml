<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
    Delta manifest for the anonymization hardening work.

    Contains only the Apex classes changed or added between commits 2d7553c and 2854ea6.
    No Custom Metadata, objects, fields, permission sets, tabs or LWC were touched — the
    full-project manifest in this same folder (package.xml) remains the one to use for a
    first-time deployment into an org that does not yet have the solution.

    Covers:
      - external ID validation rejecting base64 / special characters
      - stateful CMDT serialization fix across both batch chains
      - error truncation and accumulated-error caps
      - shared helpers consolidated into TEKCO_AnonymizationBatchUtils
      - accumulated failure counts, sandbox-abort guard, mid-chain markRunning
      - permission gating and dynamic-SOQL name validation on all AuraEnabled entry points
      - explicit sharing declarations
      - Phase 2 / Phase 3 delete logic extracted into two new services
      - test coverage for the audit service, both delete services and the batch lifecycle

    Deploy with:
      sf project deploy start  (manifest flag)  anonymization/manifest/package-hardening.xml

    Validate first, running local tests, by adding the dry-run and test-level flags.
    (Command flags are spelled out rather than written literally because a double hyphen
    is not permitted inside an XML comment.)
-->
<Package xmlns="http://soap.sforce.com/2006/04/metadata">
    <types>
        <!-- Modified: services and batches -->
        <members>TEKCO_AnonymizationAuditService</members>
        <members>TEKCO_AnonymizationBatch</members>
        <members>TEKCO_AnonymizationBatchUtils</members>
        <members>TEKCO_AnonymizationByIdBatch</members>
        <members>TEKCO_AnonymizationByIdController</members>
        <members>TEKCO_AnonymizationBypassService</members>
        <members>TEKCO_AnonymizationController</members>
        <members>TEKCO_AnonymizationExecuteService</members>
        <members>TEKCO_AnonymizationOrgConfigService</members>
        <members>TEKCO_AnonymizationPatternService</members>
        <members>TEKCO_ContentDocumentBatch</members>
        <members>TEKCO_ContentDocumentByIdBatch</members>
        <members>TEKCO_FieldHistoryBatch</members>
        <members>TEKCO_FieldHistoryByIdBatch</members>

        <!-- New: extracted delete services -->
        <members>TEKCO_ContentDocumentDeleteService</members>
        <members>TEKCO_FieldHistoryDeleteService</members>

        <!-- Tests -->
        <members>TEKCO_AnonymizationAuditServiceTest</members>
        <members>TEKCO_AnonymizationBatchTest</members>
        <members>TEKCO_AnonymizationBatchUtilsTest</members>
