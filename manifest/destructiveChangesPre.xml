<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
    destructiveChangesPre.xml
    ─────────────────────────────────────────────────────────────────────────────
    Removes the old non-TEKCO-prefixed anonymization components from the org.
    These deletions run BEFORE the new TEKCO_-prefixed components are deployed,
    so the org never has both old and new versions simultaneously.

    ⚠  WARNINGS:
      • Deleting Anonymization_Audit_Log__c will permanently destroy all existing
        audit log records. Export or migrate data first if you need to keep it.
      • Deleting the old permission set will revoke access from any users currently
        assigned to Anonymization_Admin. Re-assign TEKCO_AnonymizationAdmin after deploy.
      • Run this only once. Re-running on a clean org will return deploy errors for
        "component not found" — that is safe to ignore.

    Usage (combined with package-delta.xml):
        sf project deploy start \
            --manifest manifest/package-delta.xml \
            --pre-destructive-changes manifest/destructiveChangesPre.xml

    Usage (deletion only, no new deploy):
        sf project deploy start \
            --manifest manifest/destructiveChangesOnly.xml \
            --pre-destructive-changes manifest/destructiveChangesPre.xml
        (where destructiveChangesOnly.xml is an empty package with just <version>)
    ─────────────────────────────────────────────────────────────────────────────
-->
<Package xmlns="http://soap.sforce.com/2006/04/metadata">

    <!-- ── Permission Set ────────────────────────────────────────────────────
         Delete first: it references the permission and the object below.
         Deleting it removes user assignments to the old permission set.
    ──────────────────────────────────────────────────────────────────────── -->
    <types>
        <members>Anonymization_Admin</members>
        <name>PermissionSet</name>
    </types>

    <!-- ── Custom Permission ─────────────────────────────────────────────────
         Delete after the permission set that referenced it is gone.
    ──────────────────────────────────────────────────────────────────────── -->
    <types>
        <members>Anonymize_Data</members>
        <name>CustomPermission</name>
    </types>

    <!-- ── Apex Classes ───────────────────────────────────────────────────────
         All 7 old (non-TEKCO-prefixed) classes.
    ──────────────────────────────────────────────────────────────────────── -->
    <types>
        <members>AnonymizationSandboxGuard</members>
        <members>AnonymizationPatternService</members>
        <members>AnonymizationBypassService</members>
        <members>AnonymizationController</members>
        <members>AnonymizationBatch</members>
        <members>ContentDocumentBatch</members>
        <members>FieldHistoryBatch</members>
        <name>ApexClass</name>
    </types>

    <!-- ── Lightning Web Component ───────────────────────────────────────────
    ──────────────────────────────────────────────────────────────────────── -->
    <types>
        <members>dataAnonymizationAdmin</members>
        <name>LightningComponentBundle</name>
    </types>

    <!-- ── Custom Object ─────────────────────────────────────────────────────
         Deleting the object automatically removes all its custom fields,
         page layouts, list views and data. No need to list fields separately.
         ⚠  All existing Anonymization_Audit_Log__c records will be deleted.
    ──────────────────────────────────────────────────────────────────────── -->
    <types>
        <members>Anonymization_Audit_Log__c</members>
        <name>CustomObject</name>
    </types>

    <version>65.0</version>
</Package>
