<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
    package-delta.xml
    ─────────────────────────────────────────────────────────────────────────────
    Deploys the complete TEKCO Anonymization System.
    Use this manifest to install or update all anonymization components in one shot.

    STEP 1 — Remove old non-TEKCO components first (if they exist in the org):
        sf project deploy start \
            --manifest manifest/package-delta.xml \
            --pre-destructive-changes manifest/destructiveChangesPre.xml

    STEP 2 — Deploy only (if old components are already gone or never existed):
        sf project deploy start --manifest manifest/package-delta.xml

    ─────────────────────────────────────────────────────────────────────────────
    Deployment order is handled automatically by Salesforce. Components will be
    resolved in dependency order (object → fields → classes → permission set).
    ─────────────────────────────────────────────────────────────────────────────
-->
<Package xmlns="http://soap.sforce.com/2006/04/metadata">

    <!-- ── 1. Custom Objects ─────────────────────────────────────────────────
         Deploy objects before fields and classes that reference them.
    ──────────────────────────────────────────────────────────────────────── -->
